{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nuiapp.com" }],
      "destination": "https://nuiapp.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/es-ar/notas/:slug",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/es-ar/notas",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml",          "destination": "https://nutrismart-backend.onrender.com/sitemap.xml" },
    { "source": "/sitemap-static.xml",   "destination": "https://nutrismart-backend.onrender.com/sitemap-static.xml" },
    { "source": "/sitemap-notes-es.xml", "destination": "https://nutrismart-backend.onrender.com/sitemap-notes-es.xml" },
    { "source": "/sitemap-notes-en.xml", "destination": "https://nutrismart-backend.onrender.com/sitemap-notes-en.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/workbox-(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
